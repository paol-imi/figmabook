{
  "name": "holotype-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Holotype: Storybook to native, editable, synced Figma component libraries.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build-storybook": "turbo run build-storybook",
    "test:smoke": "turbo run test:smoke",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:deps": "depcruise packages tools spikes --config .dependency-cruiser.mjs",
    "diag:gen": "node --experimental-strip-types tools/diag-gen/src/cli.ts gen",
    "diag:check": "node --experimental-strip-types tools/diag-gen/src/cli.ts check",
    "size": "pnpm -F @holotype/plugin size",
    "demo:d1": "pnpm -F @holotype/smoke run demo",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "2.31.1",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.2",
    "tsdown": "0.23.5",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
