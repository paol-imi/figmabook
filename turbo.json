{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "vitest.shared.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**"],
      "outputs": ["dist/**", "build/**", "manifest.json", "schema/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$"],
      "dependsOn": ["^build"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$"],
      "dependsOn": ["^build"]
    },
    "@holotype/plugin#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/figma-fake/src/**"],
      "dependsOn": ["^build"]
    },
    "@holotype/plugin#typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/figma-fake/src/**"],
      "dependsOn": ["^build"]
    },
    "@holotype/diag-gen#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/plan/12-quality.md"]
    },
    "build-storybook": {
      "inputs": ["$TURBO_DEFAULT$", "!test/**"],
      "outputs": ["storybook-static/**"]
    },
    "test:smoke": {
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "HOLOTYPE_CHROMIUM_PATH"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "HOLOTYPE_CHROMIUM_PATH"]
    }
  }
}
