{
  "name": "@holotype/mapper",
  "version": "0.0.0",
  "description": "Pure Capture IR to Scene IR mapping: layout inference, text, visuals, alignment, naming, token binding. Isomorphic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@holotype/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@holotype/layout-sim": "workspace:*",
    "@holotype/ir": "workspace:*",
    "@holotype/shared": "workspace:*"
  }
}
