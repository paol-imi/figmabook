{
  "name": "@holotype/storybook",
  "version": "0.0.0",
  "description": "Storybook adapter: index, metadata, docgen and globals discovery, plus the render-loop driver.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@holotype/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@holotype/ir": "workspace:*",
    "@holotype/shared": "workspace:*",
    "playwright": "1.63.0",
    "sirv": "3.0.2"
  }
}
