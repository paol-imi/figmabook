{
  "name": "@holotype/layout-sim",
  "version": "0.0.0",
  "description": "Model of Figma's auto-layout and grid algorithm, used by mapper verification and figma-fake. Isomorphic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@holotype/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@holotype/ir": "workspace:*",
    "@holotype/shared": "workspace:*"
  }
}
