{
  "name": "@holotype/dcr",
  "version": "0.0.0",
  "description": "Deterministic Design Change Requests: Figma snapshot vs baseline diff, classification and prompt rendering. Isomorphic and pure.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@holotype/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.emit",
    "src",
    "schema"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.emit.config.ts --silent && node dist/.emit/emit-schemas.js",
    "typecheck": "tsc && tsc -p test",
    "test": "vitest run"
  },
  "dependencies": {
    "@holotype/ir": "workspace:*",
    "@holotype/shared": "workspace:*",
    "@sinclair/typebox": "~0.34.52"
  },
  "devDependencies": {
    "ajv": "8.17.1"
  }
}
